---
import Base from "../layouts/Base.astro";
import LandingPageCard from "../components/LandingPageCard.astro";
import { data } from "../data";

const featured = data.publications.filter((p) => p.featured);
const maxNews = 6; // news items shown before "See more..."
---

<Base title="Ben Hoover">
  <base slot="head" target="_blank" />

  {/* From 640px the page is a 12-column grid: dates sit in columns 1-2 and text in columns 3-10. */}
  <div class="page">
    <div class="hero main-col">
      <div class="headshot">
        <a href="imgs/people/me-headshot.jpg" target="_blank" rel="noreferrer">
          <img src="imgs/people/me-headshot-small.jpg" alt="Ben's headshot" />
        </a>
      </div>
      <div class="hero-text">
        <div>
          <h1>Hi, I'm Ben Hoover</h1>
          <h2>I'm an AI Researcher studying <span>memory</span></h2>
        </div>
        <div class="socials">
          <div class="social cv-link">
            <a target="_blank" href="/cv" rel="noreferrer">CV</a>
          </div>
          {
            data.socialLinks.map((link) => (
              <div class="social">
                <a target="_blank" href={link.href} rel="noreferrer">
                  <span class="iconify" data-icon={link.dataIcon} style={`color: ${link.color || "#515151"}`} />
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="main-col">
      <p class="tagline">
        Understanding <a href="https://research.ibm.com/blog/what-are-foundation-models" target="_blank" rel="noreferrer">AI foundation models</a> from the perspective of large <a href="https://en.wikipedia.org/wiki/Associative_memory_(psychology)" target="_blank" rel="noreferrer">Associative Memories</a>.
      </p>
      {/* Astro drops whitespace that contains a newline next to an element, so keep inline links on the same line as their surrounding text. */}
      <p class="bio">
        I am a researcher at <a href="https://prefrontal.ai">Prefrontal</a> in London. I defended my Machine Learning PhD thesis at <a href="https://poloclub.github.io/">Georgia Tech</a>, advised by <a href="https://poloclub.github.io/polochau/">Polo Chau</a>, on 6 July 2026. My research focuses on building more interpretable and parameter efficient AI by rethinking the way we train and build deep models, taking inspiration from Associative Memories and <a href="http://www.scholarpedia.org/article/Hopfield_network">Hopfield Networks</a>. I like to visualize what happens inside AI models.
      </p>
    </div>

    <h1 class="main-col">News</h1>
    <div class="news-list">
      {
        data.news.map((blurb, i) => {
          const extra = i >= maxNews ? { hidden: true, "data-news-extra": "" } : {};
          return (
            <>
              <div class="news-date" {...extra}>{blurb.date}</div>
              <div class="news-text main-col" {...extra} set:html={blurb.HTMLdescription} />
            </>
          );
        })
      }
      {
        data.news.length > maxNews && (
          <button type="button" id="news-toggle" class="main-col">
            See more...
          </button>
        )
      }
    </div>

    <section id="thesis" class="main-col">
      <p class="kicker">PhD Thesis · 2026</p>
      <a class="thesis-title" href="/papers/benjamin-hoover-thesis.pdf" rel="noreferrer">Memory as Computation: Associative Memory as a Foundation for Modern AI</a>
      <div class="thesis-links">
        <a href="/papers/benjamin-hoover-thesis.pdf" rel="noreferrer">Read the thesis (PDF) →</a>
        <a href="https://youtu.be/NoAnSDAQq0k" rel="noreferrer">Watch the defense (YouTube) →</a>
      </div>
    </section>

    <h1 class="main-col highlights-title" id="selected-memory">Research Highlights</h1>
    <div class="cards">
      {featured.map((project) => <LandingPageCard project={project} />)}
    </div>
  </div>
</Base>

<style>
  /* Layout */
  @media (min-width: 640px) {
    .page {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1rem;
    }
    .main-col {
      grid-column: 3 / 11;
    }
  }
  @media (min-width: 768px) {
    .page {
      margin: 3rem 0;
    }
  }
  .main-col {
    width: 100%;
  }
  a {
    border-bottom: var(--link-underline);
  }

  /* Header: headshot, name and social links */
  .hero {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 1rem;
  }
  .headshot {
    align-self: center;
  }
  .headshot img {
    border-radius: 0.5rem;
    box-shadow: var(--shadow-lg);
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .hero h1 {
    margin-bottom: 0.125rem;
    color: var(--slate-700);
    font-size: 1.875rem;
    line-height: 2.25rem;
    font-weight: 600;
  }
  .hero h2 {
    color: var(--slate-400);
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 300;
  }
  .hero h2 span {
    color: var(--slate-500);
    font-weight: 500;
  }
  @media (min-width: 768px) {
    .hero {
      grid-template-columns: 150px 1fr;
      gap: 2rem;
    }
    .hero-text {
      gap: 2rem;
    }
    .hero h1 {
      font-size: 2.25rem;
      line-height: 2.5rem;
    }
    .hero h2 {
      font-size: 1.875rem;
      line-height: 2.25rem;
    }
  }
  .socials {
    display: flex;
    gap: 0.5rem;
    font-size: 1.25rem;
    line-height: 1.75rem;
  }
  @media (min-width: 440px) {
    .socials {
      gap: 1rem;
    }
  }
  .social {
    padding: 0.5rem;
    border-radius: 9999px;
    background: var(--slate-100);
  }
  .social:hover {
    background: var(--slate-300);
  }
  .cv-link {
    color: var(--gray-600);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  /* Introduction */
  .tagline {
    margin: 2rem 0;
    padding-left: 1rem;
    border-left: 2px solid var(--gray-200);
    color: var(--gray-500);
    font-size: 1.5rem;
    line-height: 2rem;
  }
  .bio {
    color: var(--slate-700);
    font-weight: 300;
    line-height: 1.5rem;
  }

  /* News */
  .news-list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0 0.5rem;
    overflow-y: auto;
  }
  @media (min-width: 640px) {
    .news-list {
      display: contents;
    }
    .news-date {
      grid-column: 1 / 3;
    }
  }
  .news-date {
    justify-self: end;
    color: var(--slate-400);
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 300;
  }
  .news-text {
    margin-bottom: 0.5rem;
  }
  .news-list :global(a) {
    border-bottom: var(--link-underline);
  }
  #news-toggle {
    justify-self: end;
    text-align: left;
    color: var(--slate-400);
  }
  #news-toggle:hover {
    color: var(--slate-700);
  }

  /* Thesis */
  #thesis {
    margin-top: 3rem;
    padding: 1.25rem;
    border-radius: 0.5rem;
    background: var(--slate-50);
    box-shadow: 0 0 0 1px var(--slate-100);
  }
  .kicker {
    margin-bottom: 0.5rem;
    color: var(--slate-400);
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .thesis-title {
    display: block;
    border-bottom: 0;
    color: var(--slate-700);
    font-size: 1.25rem;
    line-height: 1.375;
    font-weight: 600;
    transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .thesis-title:hover {
    color: var(--blue-500);
  }
  .thesis-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
  }
  .thesis-links a {
    color: var(--blue-500);
  }
  .thesis-links a:hover {
    color: var(--blue-700);
  }
  @media (min-width: 768px) {
    #thesis {
      padding: 1.25rem 1.5rem;
    }
    .thesis-title {
      font-size: 1.5rem;
      line-height: 2rem;
    }
  }

  /* Research highlights */
  .highlights-title {
    margin-top: 3rem;
  }
  .cards {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .cards {
      grid-column: 3 / 11;
    }
  }
  @media (min-width: 768px) {
    .cards {
      grid-column: 2 / 12;
    }
  }
</style>

<script>
  const toggle = document.getElementById("news-toggle");
  toggle?.addEventListener("click", () => {
    const expand = toggle.textContent!.trim() === "See more...";
    document.querySelectorAll<HTMLElement>("[data-news-extra]").forEach((el) => (el.hidden = !expand));
    toggle.textContent = expand ? "Collapse..." : "See more...";
  });
</script>
