---
import Base from "../layouts/Base.astro";
import CVHeader from "../components/cv/CVHeader.astro";
import CVEducationEntry from "../components/cv/CVEducationEntry.astro";
import CVRoleEntry from "../components/cv/CVRoleEntry.astro";
import CVAwardEntry from "../components/cv/CVAwardEntry.astro";
import CVPublicationEntry from "../components/cv/CVPublicationEntry.astro";
import CVTalkEntry from "../components/cv/CVTalkEntry.astro";
import CVReviewerEntry from "../components/cv/CVReviewerEntry.astro";
import CVPressEntry from "../components/cv/CVPressEntry.astro";
import { data } from "../data";
import Icon from "../components/Icon.astro";
import "../styles/cv.css";

const { people, publications, education, experiences, awards, talks, teaching, reviewer, committee } = data;
const funding = data.funding ?? [];
const social = data.socialLinkInfo;
const email = social.email.encoded; // the address, encoded (src/lib/email.ts)
const updated = new Date().toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" }); // the build date
// Press: entries of _data/press.yaml with an outlet, newest first as in the file, unless they set `cv: false`.
const press = data.press.filter((p) => p.outlet && p.cv !== false);

const headerLinks = ["email", "homepage", "twitter", "github", "linkedin", "scholar", "cvpdf"];
const publicationGroups = [
  ["Conference", "conference"],
  ["Journal", "journal"],
  ["Tutorial", "tutorial"],
  ["Demo", "demo"],
  ["Workshop", "workshop"],
  ["Preprints", "preprint"],
].map(([title, type]) => ({ title, items: publications.filter((p) => p.type === type).sort((a, b) => b.year - a.year) })); // newest first; same-year works keep their order in the file
---

<Base title="Benjamin Hoover — CV" fonts>
  <div class="cv">
    <div class="header">
      <h1>Benjamin Hoover</h1>
      <h2>AI Researcher &amp; Engineer</h2>
      <ul class="contact">
        {
          headerLinks.map((link) => (
            <li class:list={{ "screen-only": link === "cvpdf" }}>
              {link === "email" ? (
                <a href={social.email.href} data-email={email}>
                  <Icon name={social.email.dataIcon} />
                  <span class="label" data-email-text>Email</span>
                </a>
              ) : (
                <a href={social[link].href} target={link === "homepage" ? "" : "_blank"} rel="noreferrer">
                  <Icon name={social[link].dataIcon} />
                  <span class="label">{social[link].label}</span>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    <CVHeader title="Education" />
    <div class="entries">
      {education.map((school) => <CVEducationEntry school={school} />)}
    </div>

    {
      [
        ["Industry Research Experience", "industry"],
        ["Academic Research Experience", "academic"],
      ].map(([title, type]) => (
        <>
          <CVHeader title={title} />
          <div class="entries">
            {experiences
              .filter((e) => e.type === type)
              .map((e) => (
                <CVRoleEntry title={e.institution} date={e.date} place={e.team} placeUrl={e.teamUrl} location={e.location} people={e.mentors} peopleLabel={["Mentor:", "Mentors: "]} description={e.description} directory={people} />
              ))}
          </div>
        </>
      ))
    }

    <div class="cv-avoid-break">
      <CVHeader title="Grants and Funding" />
      <div class="entries compact">
        {funding.map((award) => <CVAwardEntry award={award} />)}
      </div>
    </div>

    <CVHeader title="Awards and Honors" />
    <div class="entries compact">
      {awards.map((award) => <CVAwardEntry award={award} />)}
    </div>

    <CVHeader title="Press" />
    <div class="entries compact">
      {press.map((item) => <CVPressEntry item={item} />)}
    </div>

    <CVHeader title="Publications" />
    {
      publicationGroups.map(({ title, items }) => (
        <>
          <CVHeader title={title} level={2} />
          <div class="entries publications">
            {items.map((publication) => <CVPublicationEntry publication={publication} people={people} />)}
          </div>
        </>
      ))
    }

    <CVHeader title="Talks" />
    <div class="entries">
      {talks.map((talk) => <CVTalkEntry talk={talk} />)}
    </div>

    <CVHeader title="Teaching" />
    <div class="entries">
      {teaching.map((ta) => <CVRoleEntry title={ta.role} date={ta.date} place={ta.institution} placeUrl={ta.institutionUrl} location={ta.location} people={ta.instructors} peopleLabel={["Instructor:", "Instructors: "]} description={ta.description} directory={people} />)}
    </div>

    <CVHeader title="Service" />
    <div class="service">
      <div>
        <div class="service-title">Reviewer</div>
        <div class="service-list">
          {reviewer.map((venue) => <CVReviewerEntry venue={venue} />)}
        </div>
      </div>
      <div>
        <div class="service-title">Organizing Committee</div>
        <div class="service-list">
          {committee.map((venue) => <CVReviewerEntry venue={venue} />)}
        </div>
      </div>
    </div>

    {/* The footer: when this CV was built, and where to find it. The PDF has the same footer without its own download link. */}
    <footer class="cv-footer">
      <span>Updated {updated}</span>
      <a href="/">bhoov.com</a>
      <a class="screen-only" href={social.cvpdf.href} target="_blank" rel="noreferrer">Download PDF</a>
      <a href={social.email.href} data-email={email}><span data-email-text>Email</span></a>
    </footer>
  </div>
</Base>

<script>
  import { revealEmails } from "../lib/email";
  revealEmails();
</script>

<style>
  /* The site's type: Inter for text, JetBrains Mono for dates (src/styles/cv.css). */
  .cv {
    color: var(--text-primary);
    font-family: var(--font-sans);
    width: 95%;
    max-width: 900px;
    margin: 0 auto;
  }
  /* Room above the name on screen; the printed page has its own margin (@page). */
  .header {
    margin-bottom: 0.5rem;
    padding-top: 2rem;
  }
  @media (min-width: 640px) {
    .header {
      padding-top: 3.5rem;
    }
  }
  @media print {
    .header {
      padding-top: 0;
    }
  }
  .header h1 {
    margin: 0;
    color: var(--text-primary);
    font-size: 2rem;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .header h2 {
    margin: 0.15rem 0 0;
    color: var(--text-secondary);
    font-size: 1.1rem;
    line-height: 1.5rem;
    font-weight: 500;
  }
  /* Contact links on one row that wraps, like the site's footer. */
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    margin-top: 0.6rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }
  .contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
  }
  .contact :global(.iconify) {
    color: var(--text-muted);
  }
  /* Phones: two columns with a smaller font. The email address, the longest label, takes the first row; the other six fill three rows.
     A label still too long for its column ends in "…". */
  @media (max-width: 639px) {
    .contact {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 0.75rem;
      font-size: 0.8rem;
      line-height: 1.4rem;
    }
    .contact li {
      min-width: 0;
    }
    .contact li:first-child {
      grid-column: 1 / -1;
    }
    .contact a {
      display: flex;
      max-width: 100%;
    }
    .contact a > :global(.iconify) {
      flex: none;
    }
    .contact .label {
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
  .contact a:hover,
  .contact a:hover :global(.iconify) {
    color: var(--accent-strong);
  }
  .entries {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .entries.publications {
    gap: 1rem;
  }
  /* One-line entries (funding, awards, press) sit closer together. */
  .entries.compact {
    gap: 0.3rem;
  }
  .service {
    display: flex;
    flex-direction: column;
    row-gap: 0.75rem;
  }
  .service-title {
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 700;
  }
  .service-list {
    display: flex;
    flex-direction: column;
    row-gap: 0.25rem;
  }
  @media (min-width: 640px) {
    .service-list {
      row-gap: 0;
    }
  }
  .cv-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 1.25rem;
    margin-top: 3rem;
    padding: 1.25rem 0 3.5rem;
    border-top: 1px solid var(--rule);
    color: var(--text-muted);
    font-family: var(--font-label);
    font-size: 0.75rem;
    line-height: 1.25rem;
    letter-spacing: 0.02em;
  }
  .cv-footer a {
    color: var(--text-secondary);
  }
  @media print {
    .cv-footer {
      padding-bottom: 0;
    }
    .screen-only {
      display: none !important;
    }
  }
  /* Links turn the site's accent color on hover; links inside sentences are underlined as on the site (.prose-links). */
  .cv :global(a:hover) {
    color: var(--accent-strong);
  }
  @page {
    margin: 60px 80px;
  }
</style>
