---
import "../styles/global.css";

interface Props {
  title?: string;
  site?: boolean; // the new design: full-width page with its own containers. False keeps the old centered column (the CV).
  fonts?: boolean; // load Inter and JetBrains Mono; on by default for `site` pages, and the CV asks for them too
}
const { title = "Ben Hoover", site = false, fonts = site } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-rings.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-rings.png" />
    <title>{title}</title>
    {
      fonts && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..700;1,14..32,400..700&family=JetBrains+Mono:wght@400;500&display=swap" />
        </>
      )
    }
    <slot name="head" />
  </head>
  <body class:list={{ site }}>
    {
      site ? (
        <slot />
      ) : (
        <div class="layout">
          <slot />
        </div>
      )
    }
  </body>
</html>

<style>
  .layout {
    width: 90%;
    max-width: 1100px;
    margin: 0 auto;
  }
  @media (min-width: 640px) {
    .layout {
      width: 93%;
    }
  }
</style>
