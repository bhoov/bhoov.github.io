---
/**
 * Layout for the MDX project pages in `src/pages/*.mdx`.
 * Frontmatter fields:
 *   title    -- page heading and <title>
 *   note     -- small italic line above the heading (optional)
 *   banner   -- HTML shown above the heading, e.g. an event announcement (optional)
 *   authors  -- author names shown under the heading (optional)
 *   connect  -- keys of `_data/contacts.yaml` for the "Let's connect!" box (optional)
 * The MDX body (abstract, citation, links) renders below the authors.
 */
import Base from "./Base.astro";
import ConnectWithMe from "../components/ConnectWithMe.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const { frontmatter } = Astro.props;
const { title, note, banner, authors, connect } = frontmatter;
---

<Base title={title} site>
  <base slot="head" target="_blank" />
  <SiteHeader />
  <main class="container">
    {connect && <ConnectWithMe people={connect} />}
    {note && <p class:list={["note", { "after-connect": connect }]}>{note}</p>}
    {banner && <p class="banner" set:html={banner} />}
    <h1 class:list={{ "after-connect": connect, "has-authors": authors }}>{title}</h1>
    {
      authors && (
        <div class="authors">
          {authors.map((author) => <div>{author}</div>)}
        </div>
      )
    }
    <div class="project-body prose-links">
      <slot />
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  main {
    max-width: calc(46rem + 4rem);
    padding-top: 2.5rem;
  }
  @media (min-width: 768px) {
    main {
      padding-top: 3rem;
    }
  }
  .note {
    margin: 1.5rem 0 0;
    color: var(--text-muted);
    font-family: var(--font-label);
    font-size: 0.72rem;
    line-height: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .note.after-connect {
    margin: 1.5rem 0 0;
  }
  .banner {
    margin-top: 1rem;
    color: var(--text-secondary);
    font-size: 1.125rem;
    line-height: 1.6;
  }
  h1 {
    margin: 0.75rem 0 1.5rem;
    color: var(--text-primary);
    font-size: clamp(2.2rem, 5vw, 3rem);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  h1.after-connect {
    margin-top: 0.75rem;
  }
  h1.has-authors {
    margin-bottom: 0.75rem;
  }
  .authors {
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule);
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    font-weight: 500;
  }
  @media (min-width: 640px) {
    .authors {
      flex-direction: row;
    }
  }
  .banner :global(a) {
    color: var(--accent);
  }
  .project-body {
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .project-body :global(p) {
    margin-bottom: 1rem;
  }
  .project-body :global(h2) {
    margin: 2.5rem 0 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule);
    color: var(--text-primary);
    font-size: 1.25rem;
    line-height: 1.3;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .project-body :global(ul li) {
    position: relative;
    padding-left: 1.5rem;
  }
  .project-body :global(ul li)::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  .project-body :global(a) {
    color: var(--text-primary);
  }
  .project-body :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: 1rem 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 0.5rem;
    font-size: 0.85rem;
    line-height: 1.6;
  }
</style>
