---
import Icon from "./Icon.astro";
/**
 * A small bordered link with an icon, e.g. "PDF" or "Code", used on the home page, the works' pages and the CV.
 * A Code link to a GitHub repository shows the repository's star count, fetched at build time (src/lib/github.ts).
 */
import { LINKS } from "../config";
import { githubStars, formatStars } from "../lib/github";
import { asset } from "../lib/publications";

interface Props {
  link: { type: string; label: string; url: string };
  inline?: boolean;
}
const { link, inline = false } = Astro.props;
const stars = link.type === "code" ? await githubStars(link.url) : null;
---

<span class:list={["pill", { inline }]}>
  <a href={asset(link.url)} target="_blank" rel="noreferrer">
    <Icon name={LINKS[link.type as keyof typeof LINKS]} />
    <span>{link.label}</span>
    {
      stars !== null && (
        <span class="stars" title={`${stars.toLocaleString("en-US")} stars on GitHub`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.94 6.1 6.56.9-4.78 4.6 1.17 6.6L12 17.6l-5.89 3.1 1.17-6.6L2.5 9.5l6.56-.9z" /></svg>
          {formatStars(stars)}
        </span>
      )
    }
  </a>
</span>

<style>
  .pill {
    display: flex;
    align-items: center;
    border: 1px solid var(--rule);
    border-radius: 0.5rem;
    background: var(--surface);
    color: var(--text-secondary);
    font-size: 0.8rem;
    line-height: 1rem;
    font-weight: 500;
    transition: background 150ms, color 150ms, border-color 150ms;
  }
  .pill.inline {
    display: inline-flex;
  }
  .pill:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }
  /* The padding is on the link, not the pill, so the whole pill is a tap target. */
  a {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.35rem 0.6rem;
    border-bottom: 0 !important;
    text-decoration: none !important;
  }
  .stars {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    margin-left: 0.2rem;
    padding-left: 0.45rem;
    border-left: 1px solid currentColor;
    border-left-color: color-mix(in srgb, currentColor 25%, transparent);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .stars svg {
    width: 0.8em;
    height: 0.8em;
    fill: #e8a317;
  }
</style>
