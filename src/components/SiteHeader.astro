---
/**
 * Sticky top bar: name on the left, links to this site's own pages on the right.
 * External profiles (Scholar, GitHub, ...) are not here; they are in the hero and the footer.
 */
import { hasBlog } from "../lib/site";

const onHome = Astro.url.pathname === "/" || Astro.url.pathname === "/index.html";
const section = (id: string) => (onHome ? `#${id}` : `/#${id}`);
---

<header class="site-header">
  <div class="container bar">
    <a class="wordmark" href={onHome ? "#top" : "/"} target="_self">Ben Hoover</a>
    <nav>
      <a class="section-link" href={section("news")} target="_self">News</a>
      <a class="section-link" href={section("research")} target="_self">Research</a>
      {hasBlog && <a href="/blog/" target="_self">Blog</a>}
      <a class="cv" href="/cv" target="_self">CV</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid color-mix(in srgb, var(--rule) 70%, transparent);
    background: color-mix(in srgb, var(--page) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
  }
  .wordmark {
    padding: 0.375rem 0;
    color: var(--text-primary);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  nav a {
    padding: 0.375rem 0.625rem;
    border-radius: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 150ms, background 150ms;
  }
  nav a:hover {
    background: var(--surface-sunken);
    color: var(--text-primary);
  }
  nav .cv {
    margin-left: 0.375rem;
    padding: 0.375rem 0.875rem;
    background: var(--text-primary);
    color: white;
  }
  nav .cv:hover {
    background: var(--accent);
    color: white;
  }
  /* Phones: all four links stay; tighter spacing so they fit next to the name. */
  @media (max-width: 479px) {
    nav {
      gap: 0;
    }
    nav a {
      padding: 0.375rem 0.45rem;
      font-size: 0.85rem;
    }
    nav .cv {
      margin-left: 0.25rem;
      padding: 0.375rem 0.7rem;
    }
  }
</style>
