---
/**
 * One featured work in the home page's research list. It links to the work's page on this site (src/pages/research/[slug].astro).
 * From 640px it is a row: the teaser figure on the left; venue, title, tagline, authors, badges, description and links on the right.
 * Below 640px it is a card: the teaser fills the top, its bottom fades into the card, and the text follows.
 * A click anywhere on it opens the work's page, except on its own links.
 */
import ProjectLink from "./ProjectLink.astro";
import Badges from "./Badges.astro";
import { badges, pubUrl, venueLabel, type Link, type Publication } from "../lib/publications";
import { teaserImage } from "../lib/images";

interface Props {
  project: Publication;
}
const { project } = Astro.props;

const me = "Benjamin Hoover";
const maxAuthors = 6; // authors shown before "+N more"; Ben is always shown
const authors: string[] = project.authors ?? [];
let shown = authors.slice(0, maxAuthors);
if (authors.includes(me) && !shown.includes(me)) shown = [...shown.slice(0, maxAuthors - 1), me];
const hiddenCount = authors.length - shown.length;
const href = pubUrl(project);
---

<article class="item" data-href={href}>
  <div class="thumb">
    <img {...teaserImage(project.teaser ?? project.thumbnail)} sizes="(min-width: 640px) 15rem, calc(100vw - 2rem)" width="960" height="600" alt={`Figure from ${project.shortTitle}`} loading="lazy" decoding="async" />
  </div>
  <div class="body">
    <p class="venue">{venueLabel(project)}</p>
    <h3>
      <a href={href} target="_self" title={project.title}>{project.shortTitle}</a>
    </h3>
    {project.tagline && <p class="tagline">{project.tagline}</p>}
    <p class="authors">
      {shown.map((name, i) => (
        <>
          {i > 0 && ", "}
          {name === me ? <strong>{name}</strong> : name}
        </>
      ))}
      {hiddenCount > 0 && `, +${hiddenCount} more`}
    </p>
    <div class="badges"><Badges badges={badges(project)} /></div>
    <p class="description">{project.featureDescription}</p>
    <div class="links">
      {project.links.map((link: Link) => <ProjectLink link={link} />)}
    </div>
  </div>
</article>

<style>
  /* Phone: a card with the teaser on top. */
  .item {
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 1rem;
    background: var(--surface);
    box-shadow: var(--shadow-card);
    cursor: pointer;
  }
  /* The 16:10 teasers are cropped to 16:9 here; their margins absorb the crop. */
  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    background: white;
  }
  /* The bottom third of the teaser fades into the card. The fade is opaque before the image ends, so the text below never overlaps a half-faded figure. */
  .thumb::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 35%;
    background: linear-gradient(to bottom, transparent, var(--surface) 75%);
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    padding: 0 1.25rem 1.25rem;
  }

  /* From 640px: a row with the teaser in a framed 15rem column. */
  @media (min-width: 640px) {
    .item {
      display: grid;
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 1.75rem;
      margin: 0 -1rem;
      padding: 1.25rem 1rem;
      overflow: visible;
      border: 0;
      background: transparent;
      box-shadow: none;
      transition: background 200ms;
    }
    .thumb {
      aspect-ratio: 16 / 10;
      align-self: start;
      overflow: hidden;
      border: 1px solid var(--rule);
      border-radius: 0.75rem;
      box-shadow: var(--shadow-card);
      transition: box-shadow 200ms, transform 200ms;
    }
    .thumb::after {
      display: none;
    }
    img {
      object-fit: contain;
    }
    .body {
      padding: 0;
    }
  }
  /* Hover styles only where a pointer can hover; on touch screens a tap would leave them stuck on. */
  @media (min-width: 640px) and (hover: hover) {
    .item:hover {
      background: var(--surface-sunken);
    }
    .item:hover .thumb {
      box-shadow: var(--shadow-card-hover);
    }
    .item:hover h3 a {
      color: var(--accent-strong);
    }
  }
  @media (min-width: 640px) and (hover: hover) and (prefers-reduced-motion: no-preference) {
    .item:hover .thumb {
      transform: translateY(-2px);
    }
  }
  .item:focus-within:has(h3 a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  h3 a:focus-visible {
    outline: none;
  }

  .venue {
    margin-bottom: 0.1rem;
    color: var(--accent);
    font-family: var(--font-label);
    font-size: 0.72rem;
    line-height: 1rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  h3 {
    color: var(--text-primary);
    font-size: 1.25rem;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  h3 a {
    transition: color 150ms;
  }
  .tagline {
    margin-top: 0.2rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  /* Desktop: the tagline is one line (the YAML keeps them short); an ellipsis guards a long one. */
  @media (min-width: 640px) {
    .tagline {
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
  }
  .authors {
    margin-top: 0.375rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.45;
  }
  .authors strong {
    color: var(--text-primary);
    font-weight: 600;
  }
  .badges {
    margin-top: 0.625rem;
  }
  .badges:empty {
    display: none;
  }
  .description {
    margin-top: 0.625rem;
    color: var(--text-secondary);
    font-size: 0.925rem;
    line-height: 1.6;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.875rem;
  }
</style>

<script>
  // Open the work's page when the item is clicked anywhere outside its own links.
  for (const item of document.querySelectorAll<HTMLElement>(".item[data-href]")) {
    item.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) return;
      window.location.href = item.dataset.href!;
    });
  }
</script>
