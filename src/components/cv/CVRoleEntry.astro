---
/**
 * A CV entry for a position: a research job or a teaching role.
 * `people` are names in `_data/people.yaml` (mentors or instructors), shown after `peopleLabel`.
 * `job` (optional) is the job title, shown after the title (the employer); `place` (optional) is the team or school.
 */
interface Props {
  title: string;
  job?: string;
  date: string;
  place?: string;
  placeUrl?: string;
  location: string;
  people?: string[];
  peopleLabel: [string, string]; // singular and plural label
  description?: string;
  directory: Record<string, any>; // _data/people.yaml
}
const { title, job, date, place, placeUrl, location, people, peopleLabel, description, directory } = Astro.props;
---

<div class="cv-entry">
  <div class="cv-date">{date}</div>
  <div class="cv-title role-title">{title}{job && <span class="job">{job}</span>}</div>
  <div class="cv-place">
    {place && <><a target="_blank" rel="noreferrer" href={placeUrl}>{place}</a>, </>}{location}
  </div>
  {
    people && (
      <div class="people">
        <span class="label">{people.length > 1 ? peopleLabel[1] : peopleLabel[0]}</span>
        {people.map((name, i) => (
          <div>
            <a href={directory[name].url} target="_blank" rel="noreferrer">{name}</a>{" "}
            {i < people.length - 1 && <span class="bullet">•</span>}
          </div>
        ))}
      </div>
    )
  }
  <div class="details prose-links" set:html={description} />
</div>

<style>
  .role-title {
    margin-bottom: 0.25rem;
  }
  /* The job title, after the employer: same line, lighter. */
  .job {
    margin-left: 0.5rem;
    color: var(--text-secondary);
    font-weight: 500;
  }
  @media (min-width: 640px) {
    .role-title {
      margin-bottom: 0;
    }
  }
  .people {
    grid-column: 1;
    display: flex;
    column-gap: 0.25rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
  }
  .label {
    margin-right: 0.5rem;
  }
  .label,
  .bullet {
    color: var(--text-muted);
  }
  .people a {
    color: var(--text-secondary);
  }
  .details {
    grid-column: 1 / 3;
    margin-top: 0.15rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.35rem;
  }
</style>
