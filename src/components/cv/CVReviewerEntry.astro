---
const { venue } = Astro.props;
---

<div class="cv-avoid-break reviewer">
  <span class="venue">{venue.venue} (<b>{venue.venueShorthand}</b>)</span>
  {
    venue.years.map((year, i) => (
      <>
        <a href={year.url} target="_blank" rel="noreferrer">{year.year}</a>
        {i < venue.years.length - 1 && <span class="separator">·</span>}
      </>
    ))
  }
</div>

<style>
  .reviewer {
    margin: 0.125rem 0;
    line-height: 1.25rem;
    font-weight: 300;
  }
  .venue {
    margin-right: 1rem;
  }
  b {
    font-weight: 600;
  }
  a,
  .separator {
    color: var(--gray-400);
  }
  .separator {
    margin: 0 0.25rem;
  }
</style>
