---
/**
 * One line of the CV's Press section: the outlet, the linked article title, Ben's part in it, and the date.
 * The part is the entry's `role` ("quoted"), or "on" and the short titles of the works it is `about`.
 */
import { data } from "../../data";
import { workUrl } from "../../lib/publications";

const { item } = Astro.props;
// The works it is about, each linked to its page on this site (or its own site).
const works = ((item.about ?? []) as string[]).map((id) => data.publications.find((p: any) => p.id === id)).filter(Boolean);
---

<div class="cv-entry press">
  <div class="headline">
    <span class="outlet">{item.outlet}</span>
    <a href={item.url} target="_blank" rel="noreferrer">{item.name}</a>
    {
      item.role ? (
        <span class="part">· {item.role}</span>
      ) : (
        works.length > 0 && (
          <span class="part">
            · on{" "}
            {works.map((p: any, i: number) => (
              <>
                {i > 0 && " and "}
                <a class="work" href={workUrl(p)}>{p.shortTitle ?? p.id}</a>
              </>
            ))}
          </span>
        )
      )
    }
  </div>
  <div class="cv-date">{item.month} {item.year}</div>
</div>

<style>
  .headline {
    grid-column: 1;
    font-size: 0.875rem;
    line-height: 1.35rem;
  }
  .outlet {
    margin-right: 0.4rem;
    color: var(--text-primary);
    font-weight: 600;
  }
  a {
    color: var(--text-secondary);
  }
  .part {
    margin-left: 0.35rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .part .work {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent, #2a78d6) 45%, transparent);
    text-underline-offset: 3px;
  }
</style>
