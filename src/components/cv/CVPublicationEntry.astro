---
import ProjectLink from "../ProjectLink.astro";
import Badges from "../Badges.astro";
import { badges, type Badge } from "../../lib/publications";

interface Props {
  publication: Record<string, any>;
  people: Record<string, any>;
  maxAuthorLength?: number; // authors shown before ", and Others"
}
const { publication, people, maxAuthorLength = 7 } = Astro.props;

const authors: string[] = publication.authors;
const overflow = authors.length > maxAuthorLength;
const coFirstAuthors: string[] = publication.coFirstAuthors ?? [];
// The site's badges: awards (by their CV label) and press coverage.
const cvBadges: Badge[] = [
  ...(publication.awards ?? []).map((a: any) => ({ label: a.cv ?? a.short ?? a.name, url: a.url, kind: "award" as const })),
  ...badges(publication).filter((b) => b.kind === "press"),
];
const coFirstAuthorNote = publication.coFirstAuthorNote ?? "* indicates equal contribution";
---

<div class="publication cv-avoid-break">
  {/* The award and press badges follow the title's last word, and move to the next line when they do not fit. */}
  <div class="cv-title pub-title">
    <a href={publication.defaultUrl} target="_blank" rel="noreferrer">{publication.title}</a>{" "}
    {cvBadges.length > 0 && <span class="title-badges"><Badges badges={cvBadges} wrap /></span>}
  </div>
  <div class="authors">
    {
      authors.map((author, i) => (
        <div class="author" hidden={i >= maxAuthorLength} data-author-extra={i >= maxAuthorLength ? "" : undefined}>
          {people[author] ? (
            <a href={people[author].url} target="_blank" rel="noreferrer" class:list={{ me: people[author].me }}>{author}</a>
          ) : (
            <span>{author}</span>
          )}
          {coFirstAuthors.includes(author) && <sup aria-label="Equal contribution">*</sup>}
          {overflow && i === maxAuthorLength - 1 ? (
            <>
              <span hidden data-author-extra>,</span>
              <span class="show-authors">, and Others</span>
            </>
          ) : (
            i < authors.length - 1 && <span>,</span>
          )}
        </div>
      ))
    }
  </div>
  {coFirstAuthors.length > 0 && <div class="co-first-note">{coFirstAuthorNote}</div>}
  {/* The short name in parentheses, unless the venue's name already contains it (e.g. "ArXiv preprint (ArXiv)"). */}
  <div class="venue">{publication.venue}{publication.venueShorthand && !publication.venue.includes(publication.venueShorthand) && ` (${publication.venueShorthand})`}. {publication.year}.</div>
  <div class="links">
    {publication.links.map((link) => <ProjectLink link={link} />)}
  </div>
</div>

<style>
  .pub-title {
    margin-bottom: 0.25rem;
  }
  /* Separated from the title by a space, not a margin, so badges that wrap start flush left. */
  .title-badges {
    display: inline-flex;
    vertical-align: 0.1em;
    font-weight: 400;
  }
  .authors {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.25rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
  }
  .author {
    display: flex;
    color: var(--text-secondary);
    font-weight: 300;
  }
  .author a {
    white-space: nowrap;
  }
  .me {
    color: var(--text-primary);
    font-weight: 600;
  }
  sup {
    margin-left: 0.125rem;
    color: var(--text-secondary);
    font-weight: 600;
    line-height: 1;
  }
  .show-authors {
    cursor: pointer;
  }
  .co-first-note {
    margin-top: 0.125rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 300;
  }
  .venue {
    color: var(--text-primary);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 300;
    font-style: italic;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.3rem;
  }
</style>

<script>
  // ", and Others" reveals the remaining authors of that publication.
  for (const more of document.querySelectorAll<HTMLElement>(".publication .show-authors")) {
    more.addEventListener("click", () => {
      more.closest(".publication")!.querySelectorAll<HTMLElement>("[data-author-extra]").forEach((el) => (el.hidden = false));
      more.remove();
    });
  }
</script>
