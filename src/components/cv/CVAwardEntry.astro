---
/** One line of the CV's awards or funding: the award (linked if it has a `url`), a short description, and the date. */
const { award } = Astro.props;
---

<div class="cv-entry award">
  <div class="line">
    {award.url ? <a class="name" href={award.url} target="_blank" rel="noreferrer">{award.name}</a> : <span class="name">{award.name}</span>}
    {award.description && <span class="description" set:html={award.description} />}
  </div>
  <div class="cv-date">{award.date}</div>
</div>

<style>
  .line {
    grid-column: 1;
    font-size: 0.875rem;
    line-height: 1.35rem;
  }
  .name {
    margin-right: 0.4rem;
    color: var(--text-primary);
    font-weight: 600;
  }
  .description {
    color: var(--text-secondary);
  }
</style>
